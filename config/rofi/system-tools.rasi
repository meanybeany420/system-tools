/* Standalone menu theme: no global configuration or imported assets. */
* {
    font: "monospace 12";
    background-color: transparent;
    text-color: #eeeeee;
    margin: 0;
    padding: 0;
    spacing: 0;
}
window {
    location: center;
    width: 520px;
    background-color: #16181d;
    border: 1px;
    border-color: #7c8798;
    border-radius: 8px;
}
mainbox { children: [ inputbar, listview ]; padding: 14px; spacing: 10px; }
inputbar { children: [ prompt, entry ]; spacing: 10px; padding: 6px; }
prompt { text-color: #b9d5ff; }
entry { placeholder: "Filter…"; }
listview { lines: 10; fixed-height: false; scrollbar: false; spacing: 3px; }
element { padding: 8px; border-radius: 4px; }
element selected.normal { background-color: #34445d; text-color: #ffffff; }
element-text { background-color: inherit; text-color: inherit; }
