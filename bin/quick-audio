#!/usr/bin/env python3
"""Set the current output volume from a minimal rofi prompt."""
import os
from pathlib import Path
import re
import subprocess
import sys

SINK = "@DEFAULT_AUDIO_SINK@"
THEME = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "rofi/quick-audio.rasi"


def audio(*args):
    result = subprocess.run(["wpctl", *args], capture_output=True, text=True, timeout=5)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "Could not access the current audio output.")
    return result.stdout.strip()


def volume(text):
    text = text.strip().removesuffix("%").strip()
    if not re.fullmatch(r"[0-9]{1,3}", text) or int(text) > 100:
        raise ValueError("Enter a whole number from 0 to 100.")
    return int(text)


def main():
    if len(sys.argv) > 2:
        raise ValueError("Usage: quick-audio [0–100]")
    if len(sys.argv) == 2:
        if sys.argv[1] in ("-h", "--help"):
            print("Usage: quick-audio [0–100]\nWithout a number, opens the rofi volume prompt.")
            return
        selected = volume(sys.argv[1])
    else:
        previous = ""
        while True:
            result = subprocess.run(
                ["rofi", "-dmenu", "-no-config", "-theme", str(THEME), "-p", "",
                 "-filter", previous, "-format", "s"],
                input="", capture_output=True, text=True,
            )
            if result.returncode == 1:
                return
            if result.returncode != 0:
                raise RuntimeError(result.stderr.strip() or "Could not open the volume prompt.")
            previous = result.stdout.strip()
            try:
                selected = volume(previous)
                break
            except ValueError:
                previous = ""
    audio("set-volume", SINK, f"{selected}%")
    if selected > 0:
        audio("set-mute", SINK, "0")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as error:
        print(f"Quick Audio: {error}", file=sys.stderr)
        try:
            subprocess.run(["notify-send", "Quick Audio", str(error)], timeout=3, check=False)
        except (OSError, subprocess.TimeoutExpired):
            pass
        sys.exit(1)
